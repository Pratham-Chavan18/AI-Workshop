# ==============================================================================
# AI Workshop Frontend - Client Environment Configuration
# ==============================================================================
# NOTE: Only variables prefixed with VITE_ are embedded into the client bundle.
# NEVER place DATABASE_URL, SUPABASE_SERVICE_ROLE_KEY, or server-side session secrets here.
# All database operations are proxied safely through the backend API.
# ==============================================================================

VITE_API_URL=http://localhost:4000/api/v1
VITE_API_BASE_URL=http://localhost:4000/api/v1
