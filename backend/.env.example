# ==============================================================================
# AI Workshop Backend - Server Environment Configuration
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# These secrets MUST NEVER be shared with frontend client applications or committed to git.
# Frontend applications should only communicate with this backend API via VITE_API_BASE_URL.
# ==============================================================================

PORT=4000
NODE_ENV=development

# Direct PostgreSQL Connection URL (Supabase Transaction Pooler or Direct DB)
# In production, use pooled connection string with secure credentials.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].pooler.supabase.com:5432/postgres

# (Optional) Supabase Service-Role Client Key - Backend Only
# Used exclusively for server-side administrative operations. NEVER expose to frontend.
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJh...

# CORS Allowed Origins (Comma-separated for multiple origins in production)
CORS_ORIGIN=http://localhost:5173

# Admin API Secret Key for Protected Ops (x-admin-key header authentication)
ADMIN_API_KEY=nxtwave-super-secret-admin-key-2026
